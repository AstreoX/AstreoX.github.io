JrK14Kls0jMX-WDb0vMbt8ZwD0QVXd7NKz-XMOjOusOoypyd__l_ppCJ721JM4LTEZitBhLcllck4uLyJNAYjZ41LZ1kRMyQLXCYnkwOSBGpAI_a585pT4YPW92yhmip-oMuyZZ-oKsl6xHJV3g-ws6BLzEswLpz_be90IOmrG2QLZW5Sm9f0qkyYR9B2Hz9PqOHEfqbN2rNMBfVCeGT7KZIRaWZ9WzKFymO8hhb321q5G2niOL4MAGci_EpIo2nOd9XQLjB3EVHNDOK8FnKGXlXNnjcMgXM2GIsGuZPHjJxdw0OdYF3_Bi0lJ-ZRohUFOU-gtePyd36tbGWrGW0RmNMtvU3jG6oEtoKsTdLvPihrxhzGZkxJvaCjFWDIljSgrpNPMbAuI-1_jZJand8OgBD3emKfGBawXt6_OfdSlcDsWaq86Y_F1YlQZMnqdBUUysIa4EkA-Eh9nq6qU1yDwKwSbiVFQ_u2sgRKTLjeOc2DFKb_e2\" alt=\"PlantUML 架构图\"></p>\n<hr>\n<h2 id=\"12-配额分级规则\">12. 配额分级规则</h2>\n<table>\n<thead>\n<tr>\n<th>Tier</th>\n<th>每日消息</th>\n<th>最大空间数</th>\n<th>存储/空间</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>FREE</td>\n<td>20 条</td>\n<td>1</td>\n<td>30 MB</td>\n</tr>\n<tr>\n<td>BASIC</td>\n<td>150 条</td>\n<td>5</td>\n<td>300 MB</td>\n</tr>\n<tr>\n<td>PREMIUM</td>\n<td>无限</td>\n<td>无限</td>\n<td>2 GB</td>\n</tr>\n<tr>\n<td>ALPHA</td>\n<td>无限</td>\n<td>无限</td>\n<td>2 GB</td>\n</tr>\n<tr>\n<td>ULTRA</td>\n<td>无限</td>\n<td>无限</td>\n<td>2 GB</td>\n</tr>\n</tbody>\n</table>\n<p>有效 Tier 在查询时实时计算（<code>get_effective_tier()</code>），订阅到期后无需 cron 任务，自动降级为 FREE。</p>\n<hr>\n<h2 id=\"14-外部服务依赖汇总\">14. 外部服务依赖汇总</h2>\n<table>\n<thead>\n<tr>\n<th>服务</th>\n<th>用途</th>\n<th>接入方式</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>OpenRouter API</td>\n<td>LLM 推理 + 文本 Embedding</td>\n<td>HTTP / SSE</td>\n</tr>\n<tr>\n<td>Tokyo Bridge (8.211.149.4:8080)</td>\n<td>区域受限模型代理（Gemini 等）</td>\n<td>HTTP 透明转发</td>\n</tr>\n<tr>\n<td>PostgreSQL + pgvector</td>\n<td>关系数据 + 向量索引（HNSW）</td>\n<td>asyncpg</td>\n</tr>\n<tr>\n<td>Redis</td>\n<td>流式 Artifact 缓存状态</td>\n<td>aioredis</td>\n</tr>\n<tr>\n<td>Resend</td>\n<td>邮件验证码 + 通知</td>\n<td>HTTP API</td>\n</tr>\n<tr>\n<td>Alipay</td>\n<td>支付宝订单</td>\n<td>alipay-sdk-python</td>\n</tr>\n<tr>\n<td>Crawl4AI</td>\n<td>JS 重型网页渲染抓取</td>\n<td>Docker 服务 HTTP</td>\n</tr>\n<tr>\n<td>Jina Reader</td>\n<td>网页内容提取（备用）</td>\n<td>HTTP API</td>\n</tr>\n<tr>\n<td>SearXNG</td>\n<td>元搜索引擎（自托管，可选）</td>\n<td>